# Deployment-wide account services. Use HTTPS in production.
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DATABASE=arionys_cdn
# Generate independent secrets; never commit real values.
# AUTH_SECRET: at least 32 random characters.
AUTH_SECRET=
# R2_ENCRYPTION_KEY: exactly 64 hex characters (32 random bytes).
# Back this up outside MongoDB. Keep unchanged across redeployments.
R2_ENCRYPTION_KEY=
MAIL_API_TOKEN=
MAIL_SMTP_USER=noreply.arionys+1@gmail.com
MAIL_FROM=noreply@arionys.com
MAX_UPLOAD_BYTES=104857600
# R2 credentials are entered during each workspace's onboarding.
# Global R2 credentials are deliberately not used.
