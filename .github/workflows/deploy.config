# Deployment mode:
#   dev   -> do nothing at all (no SSH, no pull, no build, no restart)
#   build -> pull, install, build, restart via PM2 only (nothing else touched)
#   host  -> same as build, PLUS auto-create the nginx reverse proxy and
#            Let's Encrypt SSL cert for DOMAIN (only if not already set up)
MODE=host

# PM2 process name for this app
APP_NAME=yourcdn

# Absolute path to the already-cloned repo on the server
APP_PATH=/root/sites/yourcdn

# Port this app's Next.js server listens on.
# Must be unique per app if you're hosting multiple sites on the same server.
PORT=3016

# Public domain for this app. DNS A record must already point at this
# server's IP before the first "host" deploy (needed for the SSL issuance).
# Only required when MODE=host.
DOMAIN=me.cdn.stokvibe.com

# Email used for Let's Encrypt certificate registration.
# Optional — falls back to [Email] when MODE=host.
EMAIL=contact@stokvibe.com
